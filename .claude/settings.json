{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/agent-hooks/run.sh\" pretool_bash_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/agent-hooks/run.sh\" posttool_test_reminder.py"
          }
        ]
      }
    ]
  },
  "attribution": { "commit": "", "pr": "", "sessionUrl": false }
}
