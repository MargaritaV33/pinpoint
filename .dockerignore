# Keeps the build context small and avoids baking local artifacts/secrets
# into the image. See Dockerfile (issue #8).

.git

frontend/node_modules
frontend/.output
frontend/.vinxi
frontend/dist

backend/.venv
backend/__pycache__
backend/.pytest_cache
backend/pinpoint.db

**/__pycache__
**/*.pyc
**/.DS_Store

.env
