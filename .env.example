# Backend
# Docker Compose does not read this value as-is: `app`'s DATABASE_URL is
# always rebuilt from the POSTGRES_* vars below + the `postgres` service
# hostname (see docker-compose.yaml and README's "Environment variables"
# table). This default is only for local, non-Docker `make run`.
DATABASE_URL=sqlite:///./pinpoint.db
JWT_SECRET=local-development-secret-change-me
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8091
MAX_UPLOAD_MB=15
ENVIRONMENT=development

# Frontend (Vite)
# Docker Compose does not read this value either: `app`'s image is always
# built with VITE_API_BASE_URL="" (same-origin), hardcoded in
# docker-compose.yaml regardless of this file. This default is only for the
# separate-ports, two-terminal local-dev recipe in README.md.
VITE_API_BASE_URL=http://localhost:8091

# Docker Compose (consumed by docker-compose.yaml only; irrelevant to
# make run/make test)
APP_PORT=8100
POSTGRES_USER=pinpoint
POSTGRES_PASSWORD=pinpoint
POSTGRES_DB=pinpoint
